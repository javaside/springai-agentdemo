<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${user.dir}/logs/springai-code-tui.log</file>
        <!-- 不能设 append=false：RollingFileAppender 强制 append，配置期任何 WARN 都会让 logback
             把内部状态整段打到 System.out，撕裂内联 TUI 画面。历史由下面的 rollingPolicy 兜底。 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${user.dir}/logs/springai-code-tui.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <!-- 关键：不要 CONSOLE appender，任何 stdout/stderr 日志都会撕裂 TUI 画面 -->
    <root level="INFO">
        <appender-ref ref="FILE"/>
    </root>
</configuration>
