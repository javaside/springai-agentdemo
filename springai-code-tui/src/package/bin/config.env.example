# springai-code-tui 配置文件（示例）。
#
# 用法：本文件在发布包的 bin/ 目录下。把它复制为同目录（bin/）下的 config.env，按需「取消注释」并填值：
#     cd bin && cp config.env.example config.env
# 启动脚本（bin/code-tui 与 bin/code-tui.cmd）运行前会自动加载 bin/config.env（若存在）。
# 查找顺序：环境变量 CODETUI_CONFIG 指定的路径 > bin/config.env > ~/.codetui/config.env。
#
# 规则：
#   - 每行 KEY=VALUE；= 两侧不要留空格；值不要加引号（含 URL 也直接写）。
#   - 以 # 开头的行是注释、不生效。
#   - 「取消注释并填了值」的行会覆盖同名的 shell 环境变量；仍注释着的行不生效，
#     也不会清空你已在 shell 里 export 的同名变量。
#   - 至少配置一家的 API key，工具才能启动。

# ────────────── 大模型 API Key（至少配一家）──────────────
#DEEPSEEK_API_KEY=sk-your-deepseek-key
#ZHIPU_API_KEY=your-zhipu-key
#DASHSCOPE_API_KEY=sk-your-dashscope-key
#ANTHROPIC_API_KEY=sk-ant-your-key
#OPENAI_API_KEY=sk-your-openai-key

# ────────────── 可选：自定义 base-url（走代理 / 私有网关 / 海外端点）──────────────
# 不配就用各家内置默认。
#DEEPSEEK_BASE_URL=https://api.deepseek.com
#ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#ANTHROPIC_BASE_URL=https://api.anthropic.com
#OPENAI_BASE_URL=https://api.openai.com/v1

# ────────────── 可选：网络搜索（博查 Bocha） ──────────────
# 配了 key 才启用 WebSearch 工具；不配则智能体没有联网搜索能力（webFetch 抓取网页不受影响）。
# key 申请：https://open.bochaai.com/
#BOCHA_API_KEY=你的key
# 单次搜索返回条数，范围 [1, 50]，默认 8。不暴露给模型（避免模型乱开条数烧搜索额度）。
#BOCHA_SEARCH_COUNT=8

# ────────────── 可选：自定义模型清单 ──────────────
# 逗号分隔的模型 id，第一项为该家的默认模型。不配就用内置清单。
#DEEPSEEK_MODELS=deepseek-v4-pro,deepseek-v4-flash
#ZHIPU_MODELS=glm-5.2,glm-5.1,glm-5-turbo
#DASHSCOPE_MODELS=qwen3.7-max,qwen3.7-plus,qwen3.6-flash,qwen3-coder-next
#ANTHROPIC_MODELS=claude-opus-5,claude-fable-5,claude-sonnet-5,claude-haiku-4-5,claude-opus-4-8
#OPENAI_MODELS=gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna,gpt-5.5,gpt-5.4

# ────────────── 可选：调优 ──────────────
# LLM 请求 read 超时（秒）：两个数据块之间的最大间隔。默认 300，范围 [10, 3600]。
# 慢 relay / 强推理模型思考期长可调大；想更快暴露卡死可调小。
#CODETUI_LLM_READ_TIMEOUT_SECONDS=300

# 并行子 agent（ParallelTasks）并发上限。默认 4，范围 [1, 32]。
#CODETUI_SUBAGENT_CONCURRENCY=4

# 传给 JVM 的额外参数（如堆上限）。
#JAVA_OPTS=-Xmx512m
