# springai-code-tui 配置文件（示例）。
#
# 用法：本文件在发布包的 bin/ 目录下。把它复制为同目录（bin/）下的 config.env，按需「取消注释」并填值：
#     cd bin && cp config.env.example config.env
# 启动脚本（bin/code-tui 与 bin/code-tui.cmd）运行前会自动加载 bin/config.env（若存在）。
# 查找顺序：环境变量 CODETUI_CONFIG 指定的路径 > bin/config.env > ~/.codetui/config.env。
#
# 规则：
#   - 每行 KEY=VALUE；= 两侧不要留空格；值不要加引号（含 URL、空格、< > 都直接写）。
#   - 以 # 开头的行是注释、不生效。
#   - 「取消注释并填了值」的行会覆盖同名的 shell 环境变量；仍注释着的行不生效，
#     也不会清空你已在 shell 里 export 的同名变量。
#   - 至少配置一家的 API key，工具才能启动。

# ────────────── 大模型 API Key（至少配一家）──────────────
#DEEPSEEK_API_KEY=sk-your-deepseek-key
#ZHIPU_API_KEY=your-zhipu-key
#DASHSCOPE_API_KEY=sk-your-dashscope-key
#ANTHROPIC_API_KEY=sk-ant-your-key
#OPENAI_API_KEY=sk-your-openai-key
#OPENCODE_GO_API_KEY=sk-your-opencode-go-key

# ────────────── 可选：自定义 base-url（走代理 / 私有网关 / 海外端点）──────────────
# 不配就用各家内置默认。
#DEEPSEEK_BASE_URL=https://api.deepseek.com
#ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#ANTHROPIC_BASE_URL=https://api.anthropic.com
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1

# ────────────── 可选：网络搜索（三家可共存） ──────────────
# 博查 Bocha（中文内容优先，返回长摘要）。key 申请：https://open.bochaai.com/
#BOCHA_API_KEY=你的key
# 单次搜索返回条数，范围 [1, 50]，默认 8。不暴露给模型（避免模型乱开条数烧搜索额度）。
#BOCHA_SEARCH_COUNT=8
#
# Brave（英文技术内容优先，只返回简短描述）。key 申请：https://brave.com/search/api/
# 注意：查询词会发给 Brave（美国公司），属于数据出境；博查是国内服务，两者性质不同。
#BRAVE_API_KEY=你的key
# 单次搜索返回条数，范围 [1, 20]，默认 5（免费档 2000 次/月，比博查更该省）。
# 注意：它只约束「网页结果」条数。库版还会把 Brave 返回的视频结果一并解析进来，不受此值限制
# （实测 count=3 时回了 3 条网页 + 6 条视频）。这是库的行为，本项目改不了。
#BRAVE_SEARCH_COUNT=5
#
# 智谱 BigModel（国内向，返回摘要）。与博查互为冗余；按次计费（0.01–0.05 元/次，无免费档）。
# 注意：key 复用 ZHIPU_API_KEY（上面大模型段落那把）——配了它搜索工具即启用。
# 单次搜索返回条数，范围 [1, 50]，默认 8。不暴露给模型（避免模型乱开条数烧搜索额度）。
#ZHIPU_SEARCH_COUNT=8
# 搜索引擎，可选。默认 search_std（0.01 元/次）；可选 search_pro（0.03）/ search_pro_sogou /
# search_pro_quark（均 0.05）。白名单外的值静默回退 search_std。
# 注意：sogou 档的 count 仅可 10/20/30/40/50，选它时需同时把 ZHIPU_SEARCH_COUNT 调到合法值——
# 保持默认 8 的话每次搜索都会 1214 参数错误。
#ZHIPU_SEARCH_ENGINE=search_std
#
# 三家按注册状态与内容语言自选；都不配则没有联网搜索能力
# （webFetch 抓取网页不受影响）。

# ────────────── 可选：自定义模型清单 ──────────────
# 逗号分隔的模型 id，第一项为该家的默认模型。不配就用内置清单。
#DEEPSEEK_MODELS=deepseek-v4-pro,deepseek-flash
#ZHIPU_MODELS=glm-5.3,glm-5.3-flash,glm-5.2,glm-5.1,glm-5-turbo
#DASHSCOPE_MODELS=qwen3.7-max,qwen3.7-plus,qwen3.6-flash,qwen3-coder-next
#ANTHROPIC_MODELS=claude-opus-5-5,claude-fable-5-1,claude-sonnet-5-5,claude-haiku-4-5,claude-opus-5,claude-sonnet-5,claude-opus-4-8,claude-fable-5
#OPENAI_MODELS=gpt-6-astra,gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna,gpt-5.5,gpt-5.4
#OPENCODE_GO_MODELS=deepseek-v4-pro,deepseek-flash,glm-5.2,kimi-k2.7-code,qwen3.8-max

# ────────────── 可选：GitHub 提交署名（默认关闭）──────────────
# 配置后，code-tui 用 git commit 提交时会在提交信息末尾追加 Co-Authored-By 尾注，
# 使 GitHub 把 code-tui 计为该 commit 的共同作者（Contributors 列表会出现这个名字）。
# 不配置则不追加，保持默认行为。
# 值须为「名字 <邮箱>」形式；邮箱必填，否则 GitHub 不识别为有效共同作者。
#   想独立于作者本人：用幽灵邮箱（如 noreply@codetui.dev），只显示名字、不关联账号、不占贡献图；
#   想落到真实账号：填该账号绑定的邮箱，头像/链接会关联到本人。
#CODETUI_CO_AUTHOR=CodeTui <noreply@codetui.dev>

# ────────────── 可选：调优 ──────────────
# LLM 请求 read 超时（秒）：两个数据块之间的最大间隔。默认 300，范围 [10, 3600]。
# 慢 relay / 强推理模型思考期长可调大；想更快暴露卡死可调小。
#CODETUI_LLM_READ_TIMEOUT_SECONDS=300

# 并行子 agent（ParallelTasks）并发上限。默认 4，范围 [1, 32]。
#CODETUI_SUBAGENT_CONCURRENCY=4

# 后台子 agent 并发上限。默认 4，范围 [1, 32]。
#CODETUI_BACKGROUND_CONCURRENCY=4

# TaskOutput 阻塞等待后台结果的上限（秒）。默认 300，范围 [1, 3600]。
#CODETUI_TASK_OUTPUT_TIMEOUT_SECONDS=300

# 回合内单工具调用上限（如 Edit 连续调用次数）。默认不限——大任务不设防；
# 需要防「同工具死循环烧 token」时再配。撞限不终止回合：错误文本回给模型，由它自行收敛
# （换工具 / 收尾汇报）。缺失 / 非法 / 非正数一律视为不限。
#CODETUI_MAX_CALLS_PER_TOOL=200

# 回合内工具调用总量上限（所有工具合计，含只读的 Read/Grep）。默认不限，语义同上。
#CODETUI_MAX_TOTAL_TOOL_CALLS=600

# ────────────── 可选：/goal 目标循环 ──────────────
# /goal <条件> 设定目标后 agent 跨轮自主推进，每轮结束由独立小模型评估是否达成。
# 评估器未单独配置时跟随当前模型。熔断均为暂停语义（发消息可恢复并清零计数）。
#
# 独立评估器模型（providerId:modelId，如 zhipu:glm-5-flash）。空 = 跟随当前模型。
#CODETUI_GOAL_EVALUATOR_MODEL=
# 自动轮上限（用户消息轮不计入）。默认 25，范围 [1, 200]。
#CODETUI_GOAL_MAX_TURNS=25
# 连续「无进展」判定达到该次数即暂停（STALLED）。默认 3，范围 [1, 10]。
#CODETUI_GOAL_STALLED_LIMIT=3
# 本 goal 的 token 预算（相对激活时的增量计账）。默认 5000000，0 = 关闭。
#CODETUI_GOAL_TOKEN_BUDGET=5000000
# 轮间可视倒计时秒数。默认 3，0 = 背靠背连发，范围 [0, 60]。
#CODETUI_GOAL_TURN_GAP_SECONDS=3
# 回合错误自动续跑次数（连续 +1 次即暂停）。默认 2，范围 [0, 10]。
#CODETUI_GOAL_ERROR_RETRY=2
# 评估器调用异常 / 超时达到该次数即暂停（EVALUATOR）。默认 2，范围 [1, 10]。
#CODETUI_GOAL_EVAL_FAIL_LIMIT=2
# 评估输出解析失败达到该次数即暂停（PROTOCOL）。默认 3，范围 [1, 10]。
#CODETUI_GOAL_PROTOCOL_FAIL_LIMIT=3
# 单次评估调用的超时（秒）。默认 60，范围 [5, 300]。
#CODETUI_GOAL_EVAL_TIMEOUT_SECONDS=60

# 任务面板过期提醒：控制器连续 N 次工具调用未更新 TodoWrite 且清单有未完成项时，
# 把清单快照追加到工具结果尾部提醒模型更新（只进模型上下文，scrollback 不显示）。
# 清单更新后重新计数，/clear 清空快照。默认 8，0 = 关闭。
#CODETUI_TODO_REMIND_EVERY=8

# 日志级别由发布包固定为 INFO（保留 WARN/ERROR），不提供 DEBUG/TRACE 开关；日志只写文件。

# 传给 JVM 的额外参数（如堆上限）。
#JAVA_OPTS=-Xmx512m
