#!/bin/sh
# springai-code-tui 启动脚本。解压发布包后直接执行本脚本即可运行。
# 需求：JDK 21+。
# 配置：把安装目录下 config.env.example 复制为 config.env 并填 API key（至少一家）；或直接用环境变量。
#   可配项：DEEPSEEK_API_KEY / ZHIPU_API_KEY / ANTHROPIC_API_KEY / OPENAI_API_KEY（及各自 *_BASE_URL）、
#   CODETUI_LLM_READ_TIMEOUT_SECONDS、CODETUI_SUBAGENT_CONCURRENCY、JAVA_OPTS。
# 用法：在一个「可随意丢弃、且已被 git 干净纳管」的项目目录里运行本工具。
set -e

# 解析脚本真实所在目录（跟随符号链接），推出安装根目录
SCRIPT="$0"
while [ -h "$SCRIPT" ]; do
    LINK=$(readlink "$SCRIPT")
    case "$LINK" in
        /*) SCRIPT="$LINK" ;;
        *)  SCRIPT="$(dirname "$SCRIPT")/$LINK" ;;
    esac
done
BIN_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT")" && pwd -P)
APP_HOME=$(CDPATH= cd -- "$BIN_DIR/.." && pwd -P)

# 加载可选配置文件 config.env（KEY=VALUE；# 开头为注释）。取消注释的行覆盖同名环境变量。
# 查找顺序：$CODETUI_CONFIG > 安装目录/config.env > ~/.codetui/config.env。set -a 使其自动导出给 JVM 进程。
CONFIG=""
if [ -n "${CODETUI_CONFIG:-}" ] && [ -f "$CODETUI_CONFIG" ]; then
    CONFIG="$CODETUI_CONFIG"
elif [ -f "$APP_HOME/config.env" ]; then
    CONFIG="$APP_HOME/config.env"
elif [ -f "$HOME/.codetui/config.env" ]; then
    CONFIG="$HOME/.codetui/config.env"
fi
if [ -n "$CONFIG" ]; then
    set -a
    . "$CONFIG"
    set +a
fi

# 定位 java：优先 JAVA_HOME
if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
    JAVA="$JAVA_HOME/bin/java"
elif command -v java >/dev/null 2>&1; then
    JAVA=java
else
    echo "错误：未找到 java。请安装 JDK 21+（或设置 JAVA_HOME）后重试。" >&2
    exit 1
fi

# 日志目录：默认写到安装目录（解压包）下的 logs/，与程序同处、不污染用户项目目录。
# 若安装在只读位置无法写入，回退到用户级 ~/.codetui/logs。选定后经系统属性交给 logback（见 logback.xml）。
# 务必在此确保目录可写：logback 配置期若因目录不可写报 WARN，会把内部状态打到 stdout 撕裂 TUI。
LOG_DIR="$APP_HOME/logs"
if ! ( mkdir -p "$LOG_DIR" 2>/dev/null && [ -w "$LOG_DIR" ] ); then
    LOG_DIR="$HOME/.codetui/logs"
    mkdir -p "$LOG_DIR" 2>/dev/null || true
fi

# manifest 的 Class-Path 相对 jar 定位 lib/，故这里以 jar 绝对路径启动，cwd 保持用户当前项目目录
exec "$JAVA" ${JAVA_OPTS:-} -Dcodetui.log.dir="$LOG_DIR" -jar "$APP_HOME/springai-code-tui.jar" "$@"
