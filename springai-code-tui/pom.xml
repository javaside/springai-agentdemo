<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.javaside</groupId>
        <artifactId>springai-agentdemo</artifactId>
        <version>1.18.2</version>
    </parent>

    <artifactId>springai-code-tui</artifactId>
    <name>springai-code-tui</name>
    <description>基于 Spring AI 2.0 的代码编写智能体，TamboUI 单栏 TUI（纯 Java，原始 API）</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-deepseek</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-anthropic</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-openai</artifactId>
        </dependency>
        <!-- 官方 SDK 的 okhttp client 模块：直接建带完整 Timeout 的 client（read 可配 + 禁 callTimeout），
             绕过 spring-ai 每请求从 ClientOptions.timeout 重建超时的行为。版本对齐 BOM 解析的 *-java-core。 -->
        <dependency>
            <groupId>com.openai</groupId>
            <artifactId>openai-java-client-okhttp</artifactId>
            <version>4.39.1</version>
        </dependency>
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java-client-okhttp</artifactId>
            <version>2.40.1</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-client-chat</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springaicommunity</groupId>
            <artifactId>spring-ai-agent-utils</artifactId>
            <version>${spring-ai-agent-utils.version}</version>
        </dependency>
        <!-- 事件溯源会话记忆（替代 MessageChatMemoryAdvisor 滑窗）：内存仓库 + 压缩策略，版本走父 BOM -->
        <dependency>
            <groupId>org.springaicommunity</groupId>
            <artifactId>spring-ai-session-management</artifactId>
        </dependency>
        <!-- MCP 客户端：只用其 SyncMcpToolCallback 适配层（Tool→ToolCallback）；
             传递带入 io.modelcontextprotocol.sdk:mcp-core（含 stdio/SSE/Streamable 传输）。 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-mcp</artifactId>
        </dependency>

        <!-- 行内显示差分渲染兼容层必须排在官方 TamboUI jar 前，优先提供同 FQN InlineDisplay。 -->
        <dependency>
            <groupId>io.github.javaside</groupId>
            <artifactId>springai-tamboui-inline-patch</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.tamboui</groupId>
            <artifactId>tamboui-tui</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.tamboui</groupId>
            <artifactId>tamboui-widgets</artifactId>
        </dependency>
        <!-- 声明式 DSL（InlineApp / InlineToolkitRunner / scope 折叠面板 / textInput）：
             固定在输入框上方、原地更新、用完收缩的计划面板靠它按 preferredSize 每帧增减高度实现。 -->
        <dependency>
            <groupId>dev.tamboui</groupId>
            <artifactId>tamboui-toolkit</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.tamboui</groupId>
            <artifactId>tamboui-jline3-backend</artifactId>
        </dependency>

        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
        <!-- 仅用内容魔数检测文件类型（不引完整 Tika parser）：替换手写魔数白名单 -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>3.3.1</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <!-- 生成方法参数名（-parameters）：本模块自写的 @Tool（如 TodoWriteToolAdapter）依赖参数名
                 作为工具入参 schema 的属性名。缺了它 Spring AI 只拿到 arg0，schema 与模型产出对不上。
                 库自带的工具类在其各自 jar 里已带 -parameters，故只需给本模块补上。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-deps</id>
                        <phase>package</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>io.github.javaside.springai.codetui.CodeTuiApplication</mainClass>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                            <!-- 写入 Implementation-Version（=project.version），供欢迎横幅在运行时读取版本号 -->
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
                <configuration>
                    <!-- 测试期日志导到 target/test-logs，不污染运行期日志位置（~/.codetui/logs）：
                         否则 mvn test 会把测试噪声（含故意抛异常的用例栈）混进用户真实日志，误导排查。 -->
                    <systemPropertyVariables>
                        <codetui.log.dir>${project.build.directory}/test-logs</codetui.log.dir>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          发布打包：mvn -pl springai-code-tui clean package -Pdist
          产出 target/springai-code-tui-<version>-dist.tar.gz 和 .zip，
          解压后执行 bin/code-tui（或 java -jar springai-code-tui.jar）即可运行。
          默认 package 不触发本 profile，保持日常构建轻量。
        -->
        <profile>
            <id>dist</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <version>3.7.1</version>
                        <executions>
                            <execution>
                                <id>make-dist</id>
                                <phase>package</phase>
                                <goals><goal>single</goal></goals>
                                <configuration>
                                    <!-- 归档名带版本：springai-code-tui-<version>-dist.tar.gz（finalName 本身无版本） -->
                                    <finalName>${project.artifactId}-${project.version}</finalName>
                                    <appendAssemblyId>true</appendAssemblyId>
                                    <descriptors>
                                        <descriptor>src/package/assembly.xml</descriptor>
                                    </descriptors>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
