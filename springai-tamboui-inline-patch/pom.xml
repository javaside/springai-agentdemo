<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.javaside</groupId>
        <artifactId>springai-agentdemo</artifactId>
        <version>1.18.2</version>
    </parent>

    <artifactId>springai-tamboui-inline-patch</artifactId>
    <name>springai-tamboui-inline-patch</name>
    <description>TamboUI 0.4.0 行内显示差分渲染兼容层</description>

    <dependencies>
        <dependency>
            <groupId>dev.tamboui</groupId>
            <artifactId>tamboui-core</artifactId>
        </dependency>
        <!--
          允许本模块 shadow 同包同名类 dev.tamboui.tui.InlineTuiRunner（事件循环抗异常治本修复）。
          本模块只"引用" tamboui-tui 的 Event/RenderThread/Schedulers 等符号以编译 shadow 类，
          不改其行为；运行期由 code-tui 的 MANIFEST Class-Path 顺序保证本模块 jar 排在
          tamboui-tui 之前，从而 JVM 优先加载本模块的 InlineTuiRunner。
          tamboui-tui 不依赖本模块，故无循环依赖。
        -->
        <dependency>
            <groupId>dev.tamboui</groupId>
            <artifactId>tamboui-tui</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
